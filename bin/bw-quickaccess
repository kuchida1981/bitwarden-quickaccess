#!/usr/bin/env bash
# bw-quickaccess: bw / jq / fzf を組み合わせた 1Password Quick Access 相当のターミナルツール
set -euo pipefail

: "${BWQA_VERSION:=dev}"

BWQA_SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
BWQA_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

# shellcheck source=lib/common.sh
source "$BWQA_ROOT/lib/common.sh"
# shellcheck source=lib/preflight.sh
source "$BWQA_ROOT/lib/preflight.sh"
# shellcheck source=lib/clipboard.sh
source "$BWQA_ROOT/lib/clipboard.sh"
# shellcheck source=lib/session.sh
source "$BWQA_ROOT/lib/session.sh"
# shellcheck source=lib/search.sh
source "$BWQA_ROOT/lib/search.sh"
# shellcheck source=lib/fields.sh
source "$BWQA_ROOT/lib/fields.sh"

bwqa_print_usage() {
  printf '%s\n' "$BWQA_MSG_USAGE_TEXT"
}

bwqa_main() {
  bwqa_run_preflight
  bwqa_ensure_cache_dir
  bwqa_reset_copy_status
  bwqa_get_session

  while true; do
    local item_id
    item_id="$(bwqa_read_last_item)"

    if [[ -z "$item_id" ]]; then
      item_id="$(bwqa_run_search_screen)"
      if [[ -z "$item_id" ]]; then
        # 検索画面で Esc 等によりキャンセルされた
        break
      fi
      bwqa_write_last_item "$item_id"
    fi

    local screen_status=0
    bwqa_run_field_screen "$item_id" || screen_status=$?

    case "$screen_status" in
      1)
        # Esc: 検索画面へ戻る
        bwqa_clear_last_item
        continue
        ;;
      2)
        # コピー可能フィールドがない: 検索へ戻す
        bwqa_clear_last_item
        continue
        ;;
      *)
        # q または想定外: ツールを終了する
        break
        ;;
    esac
  done
}

bwqa_run_lock_subcommand() {
  bwqa_ensure_cache_dir
  bwqa_detect_platform
  bwqa_cmd_lock
}

case "${1:-}" in
  __copy-field)
    shift
    bwqa_copy_field_internal "${1:-}"
    ;;
  __copy-status)
    bwqa_ensure_cache_dir
    bwqa_render_copy_status
    ;;
  lock)
    bwqa_run_lock_subcommand
    ;;
  -v | --version)
    echo "bw-quickaccess $BWQA_VERSION"
    exit 0
    ;;
  -h | --help)
    bwqa_print_usage
    ;;
  "")
    bwqa_main
    ;;
  *)
    # BWQA_MSG_* はこのプロジェクトが定義する固定テンプレート(lib/i18n/*.sh)であり、
    # ユーザー入力ではないため、変数を printf の書式文字列として使う設計を許容する。
    # shellcheck disable=SC2059
    bwqa_log "$(printf "$BWQA_MSG_UNKNOWN_ARG" "$1")"
    bwqa_print_usage >&2
    exit 1
    ;;
esac
