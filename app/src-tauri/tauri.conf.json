{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bitwarden Quick Access",
  "identifier": "com.kuchida1981.bw-quickaccess",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "script-src": ["'self'"],
        "style-src": ["'self'"],
        "img-src": ["'self'", "https://icons.bitwarden.net"],
        "connect-src": ["ipc:", "http://ipc.localhost"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns", "icons/128x128.png", "icons/128x128@2x.png", "icons/32x32.png"]
  }
}
